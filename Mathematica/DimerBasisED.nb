Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"L", "=", "2"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"system", " ", "size"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Nsite", "=", 
    RowBox[{"4", "*", "L"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"number", " ", "of", " ", "sites"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Nbond", "=", 
    RowBox[{"6", "*", "L"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"similar", " ", "to", " ", "the", " ", 
     RowBox[{"C", "++"}], " ", "object", " ", "in", " ", "the", " ", 
     "lattice", " ", "class"}], ",", " ", 
    RowBox[{
    "tells", " ", "me", " ", "what", " ", "sites", " ", "are", " ", 
     "attached", " ", "to", " ", "what", " ", "bonds"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"bnd2site", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"site", ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"site", "+", "1"}], ",", "L", ",", "1"}], "]"}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"site", ",", "1", ",", "Nsite"}], "}"}]}], "]"}]}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bnd2site", "=", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"site", ",", 
             RowBox[{"site", "+", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"site", "+", "1"}], ",", 
             RowBox[{"site", "+", "2"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"site", "+", "1"}], ",", 
             RowBox[{"site", "+", "3"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"site", "+", "2"}], ",", 
             RowBox[{"site", "+", "3"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"site", "+", "2"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"site", "+", "4"}], ",", "Nsite", ",", "1"}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"site", "+", "3"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"site", "+", "4"}], ",", "Nsite", ",", "1"}], "]"}]}], 
            "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"site", ",", "1", ",", "Nsite", ",", "4"}], "}"}]}], "]"}], 
       "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "A", " ", "list", " ", "of", " ", "2", "x2", " ", "identity", " ", 
     "matrices"}], ",", " ", 
    RowBox[{
     RowBox[{"taking", " ", "the", " ", "outer", " ", "product", " ", 
      RowBox[{"(", 
       RowBox[{"kronecker", " ", "product"}], ")"}], " ", "gives", " ", "the",
       " ", "identity", " ", "in", " ", "the", " ", "full", " ", "many"}], 
     "-", 
     RowBox[{"body", " ", "hilbert", " ", 
      RowBox[{"space", ".", "  ", "If"}], " ", "one", " ", "of", " ", "the", 
      " ", "identities", " ", "is", " ", "replaced", " ", "by", " ", "a", " ",
       "spin", " ", "operator"}]}], ",", " ", 
    RowBox[{
    "the", " ", "kronecker", " ", "product", " ", "gives", " ", "that", " ", 
     "operator", " ", "in", " ", "the", " ", "full", " ", "Hilber", " ", 
     "space"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"idenlist", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "Nsite"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "takes", " ", "the", " ", "outer", " ", "product", " ", "of", " ", "the", 
     " ", "list", " ", "of", " ", "matrices"}], ",", " ", 
    RowBox[{
    "creates", " ", "many", " ", "body", " ", "matrix", " ", "from", " ", 
     "list", " ", "of", " ", "2", "x2", " ", "matrices"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gtmb", "[", "a_", "]"}], ":=", 
    RowBox[{"1.0", "*", 
     RowBox[{"Fold", "[", 
      RowBox[{"KroneckerProduct", ",", 
       RowBox[{"a", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"a", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "Nsite"}], "]"}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SdS", " ", "stands", " ", "for", " ", "\"\<S dot S\>\""}], ",", 
    " ", 
    RowBox[{
    "taking", " ", "the", " ", "dot", " ", "product", " ", "of", " ", "the", 
     " ", "spin", " ", "operators", " ", "on", " ", "site", " ", "i", " ", 
     "and", " ", "j", " ", "in", " ", "the", " ", "full", " ", "Hilbert", " ",
      "space"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SdS", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"gtmb", "[", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"idenlist", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"i", "\[Rule]", " ", 
           RowBox[{"0.5", "*", 
            RowBox[{"PauliMatrix", "[", "a", "]"}]}]}], ",", 
          RowBox[{"j", "\[Rule]", " ", 
           RowBox[{"0.5", "*", 
            RowBox[{"PauliMatrix", "[", "a", "]"}]}]}]}], "}"}]}], "]"}], 
      "]"}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", "3"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "full", " ", "hamiltonian", " ", "as", " ", "a", " ", "sum", 
     " ", "of", " ", "bond", " ", "operators"}], ",", " ", 
    RowBox[{"with", " ", "constant", " ", "shift"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Ham", "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"SdS", "[", 
         RowBox[{
          RowBox[{"bnd2site", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"bnd2site", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "Nbond"}], "}"}]}], "]"}], "-", 
      RowBox[{"Nbond", "*", 
       RowBox[{"(", "0.25", ")"}], "*", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Band", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], "]"}], "\[Rule]", "1.0"}], ",", 
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox["2", "Nsite"], ",", 
           SuperscriptBox["2", "Nsite"]}], "}"}]}], "]"}]}]}]}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ham", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"SdS", "[", 
       RowBox[{
        RowBox[{"bnd2site", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"bnd2site", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "Nbond"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<groundstate energy is\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigv", "=", 
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"Ham", ",", "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "eigv", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"eigv", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Eigenvalues", "[", "Ham", "]"}], ",", "16"}], "]"}]}], ";", 
    " ", 
    RowBox[{"(*", 
     RowBox[{"Get", " ", "all", " ", "the", " ", "Eigenvalues"}], "*)"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"beta", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10", "*", "i"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "10"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pafx", "[", "b_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"b", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "*", "eigv"}], "]"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "b", "]"}]}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"Partition", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nzen", "[", "b_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"eigv", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"b", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "*", "eigv"}], "]"}]}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "b", "]"}]}], "}"}]}], "]"}], " ", "/", " ", 
      
      RowBox[{"pafx", "[", "b", "]"}]}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"Mean", " ", "value", " ", "of", " ", "the", " ", "energy"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"energy", " ", "=", " ", 
     RowBox[{"nzen", "[", "beta", "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<With beta=\>\"", ",", "beta", ",", "\"\< energy is:\>\""}],
       "]"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "energy", "]"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
