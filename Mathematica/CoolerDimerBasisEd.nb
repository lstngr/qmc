Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"L", "=", "4"}], ";", " ", 
   RowBox[{"(*", 
    RowBox[{"system", " ", "size"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Nsite", "=", 
    RowBox[{"2", "*", "L"}]}], ";", " ", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "sites"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Nbond", "=", 
    RowBox[{"2", "*", "L"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"similar", " ", "to", " ", "the", " ", 
     RowBox[{"C", "++"}], " ", "object", " ", "in", " ", "the", " ", 
     "lattice", " ", "class"}], ",", " ", 
    RowBox[{
    "tells", " ", "me", " ", "what", " ", "sites", " ", "are", " ", 
     "attached", " ", "to", " ", "what", " ", "bonds"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"bnd2site", "=", 
