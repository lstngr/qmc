           RowBox[{"site", "+", "1"}], ",", "L", ",", "1"}], "]"}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"site", ",", "1", ",", "Nsite"}], "}"}]}], "]"}]}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bnd2site", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"site", ",", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"site", "+", "1"}], ",", "Nsite", ",", "1"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"site", ",", "1", ",", "Nsite"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "A", " ", "list", " ", "of", " ", "4", "x4", " ", "identity", " ", 
     "matrices"}], ",", " ", 
    RowBox[{
     RowBox[{"taking", " ", "the", " ", "outer", " ", "product", " ", 
      RowBox[{"(", 
       RowBox[{"kronecker", " ", "product"}], ")"}], " ", "gives", " ", "the",
       " ", "identity", " ", "in", " ", "the", " ", "full", " ", "many"}], 
     "-", 
     RowBox[{"body", " ", "hilbert", " ", 
      RowBox[{"space", ".", "  ", "If"}], " ", "one", " ", "of", " ", "the", 
      " ", "identities", " ", "is", " ", "replaced", " ", "by", " ", "a", " ",
       "spin", " ", "operator"}]}], ",", " ", 
    RowBox[{
    "the", " ", "kronecker", " ", "product", " ", "gives", " ", "that", " ", 
     "operator", " ", "in", " ", "the", " ", "full", " ", "Hilber", " ", 
     "space"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"idenlist", "=", 
    RowBox[{"Table", "[", 
