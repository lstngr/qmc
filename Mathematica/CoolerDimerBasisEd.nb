      RowBox[{"SparseArray", "[", 
       RowBox[{"IdentityMatrix", "[", "4", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "Nsite"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "takes", " ", "the", " ", "outer", " ", "product", " ", "of", " ", "the", 
     " ", "list", " ", "of", " ", "matrices"}], ",", " ", 
