    "creates", " ", "many", " ", "body", " ", "matrix", " ", "from", " ", 
     "list", " ", "of", " ", "4", "x4", " ", "matrices"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gtmb", "[", "a_", "]"}], ":=", 
   RowBox[{"1.0", "*", 
    RowBox[{"Fold", "[", 
     RowBox[{"KroneckerProduct", ",", 
      RowBox[{"a", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"a", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", "Nsite"}], "]"}], "]"}]}], "]"}]}]}], 
